{
  "name": "pigallery2plus",
  "version": "3.6.0-plus.12",
  "description": "PiGallery2 Plus is a performance and metadata focused fork of PiGallery2",
  "author": "Patrik J. Braun and PiGallery2 Plus contributors",
  "homepage": "https://github.com/Railline/pigallery2plus",
  "license": "MIT",
  "main": "./src/backend/index.js",
  "bin": "./src/backend/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.backend.json && gulp build-prod",
    "build-en": "tsc -p tsconfig.backend.json && gulp build-prod --languages=en",
    "create-release": "gulp create-release",
    "build-backend": "tsc -p tsconfig.backend.json",
    "pretest": "tsc -p tsconfig.backend.json",
    "test": "ng test  && nyc mocha test --exclude test/cypress/**/*.js --exclude folder-reset.js",
    "test-frontend": "ng test",
    "test-backend": "tsc -p tsconfig.backend.json && nyc mocha test --exit --exclude test/cypress/**/*.js --exclude folder-reset.js",
    "coverage": "nyc report --reporter=lcov",
    "start": "node ./src/backend/index",
    "run-diagnostics": "node ./src/backend/index --run-diagnostics --Server-Log-level=silly",
    "run-dev": "ng build  --configuration=dev",
    "build-stats": "ng build  --stats-json",
    "analyze": "webpack-bundle-analyzer dist/en/stats.json",
    "merge-new-translation": "gulp merge-new-translation",
    "generate-man": "gulp generate-man",
    "lint": "ng lint",
    "start-e2e-server": "node ./test/folder-reset test/e2e && node ./src/backend/index --config-path=test/e2e/config.json --Database-dbFolder=test/e2e --Server-port=8080 --Users.suppressDefUserWarn=true",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "build-extension-interface": "tsc -p extension/ext-interface.tsconfig.json && tsc -p extension/ext-enums.tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Railline/pigallery2plus.git"
  },
  "bugs": {
    "url": "https://github.com/Railline/pigallery2plus/issues"
  },
